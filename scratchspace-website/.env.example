# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/scratchspace_dev"

# NextAuth
# IMPORTANT: Update port to match your dev server (default: 3002)
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Admin Seed (for initial setup)
ADMIN_EMAIL="your-email@example.com"
ADMIN_PASSWORD="your-secure-password-min-12-chars"

# Google Analytics (optional)
# Get your GA4 Measurement ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Site URL (required for SEO)
NEXT_PUBLIC_SITE_URL="https://scratchspace.dev"
